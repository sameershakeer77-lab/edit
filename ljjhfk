<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Astra Live AI & Private Vault</title>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0; padding: 20px; background: #090d16; color: #e2e8f0;
      font-family: system-ui, -apple-system, sans-serif;
      display: flex; flex-direction: column; align-items: center;
    }
    .orb {
      width: 120px; height: 120px; border-radius: 50%;
      background: radial-gradient(circle, #38bdf8, #1d4ed8);
      box-shadow: 0 0 35px rgba(56, 189, 248, 0.4);
      margin: 15px 0; cursor: pointer; transition: all 0.25s ease;
    }
    .orb.listening {
      background: radial-gradient(circle, #4ade80, #15803d);
      box-shadow: 0 0 45px rgba(74, 222, 128, 0.7);
      animation: pulse 1.4s infinite;
    }
    .orb.speaking {
      background: radial-gradient(circle, #c084fc, #6b21a8);
      box-shadow: 0 0 55px rgba(192, 132, 252, 0.85);
      animation: wave 0.6s infinite alternate;
    }
    @keyframes pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.1); } }
    @keyframes wave { 0% { transform: scale(0.94); } 100% { transform: scale(1.15); } }
    #status { font-weight: 600; color: #94a3b8; margin-bottom: 12px; }
    .transcript-box {
      width: 100%; max-width: 720px; background: #1e293b;
      border: 1px solid #334155; border-radius: 10px; padding: 14px;
      margin-bottom: 16px; min-height: 68px; line-height: 1.5;
    }
    .manual-bar {
      display: flex; gap: 8px; width: 100%; max-width: 720px; margin-bottom: 20px;
    }
    .manual-bar input {
      flex: 1; padding: 10px 14px; border-radius: 8px; border: 1px solid #334155;
      background: #0f172a; color: #fff; font-size: 0.95rem;
    }
    .manual-bar button {
      padding: 10px 18px; border-radius: 8px; border: none;
      background: #2563eb; color: #fff; font-weight: 600; cursor: pointer;
    }
    .grid {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 16px; width: 100%; max-width: 720px;
    }
    .card {
      background: #111827; border: 1px solid #1f2937; border-radius: 10px; padding: 14px;
    }
    .card h3 { margin-top: 0; font-size: 1rem; color: #38bdf8; border-bottom: 1px solid #1f2937; padding-bottom: 8px; }
    ul { list-style: none; padding: 0; margin: 0; font-size: 0.9rem; }
    li { padding: 6px 0; border-bottom: 1px solid #1e293b; display: flex; justify-content: space-between; }
    .done { text-decoration: line-through; color: #64748b; }
  </style>
</head>
<body>

  <div id="orb" class="orb" onclick="toggleVoice()"></div>
  <div id="status">Tap Orb to Start Live Voice Session</div>

  <div id="log" class="transcript-box">
    <strong>Try speaking or typing:</strong><br>
    • "Add task check black denim stock"<br>
    • "Set cotton wholesale price to 180 rupees"<br>
    • "What is our cotton wholesale price?"
  </div>

  <div class="manual-bar">
    <input id="cmdInput" type="text" placeholder="Or type a command here..." onkeydown="if(event.key==='Enter') sendText()" />
    <button onclick="sendText()">Run</button>
  </div>

  <div class="grid">
    <div class="card">
      <h3>📋 Tasks Table (Local DB)</h3>
      <ul id="taskList"><li>No tasks yet</li></ul>
    </div>
    <div class="card">
      <h3>🔒 Private Vault (Never Leaves Device)</h3>
      <ul id="vaultList"><li>No vault records yet</li></ul>
    </div>
  </div>

  <script>
    const orb = document.getElementById("orb");
    const statusEl = document.getElementById("status");
    const logEl = document.getElementById("log");
    const synth = window.speechSynthesis;
    let ws;
    let recognition;
    let isListening = false;

    function connectWS() {
      ws = new WebSocket(`ws://${location.host}/ws`);
      ws.onmessage = (event) => {
        const msg = JSON.parse(event.data);
        if (msg.type === "db_sync") {
          renderDB(msg.data);
        } else if (msg.type === "ai_reply") {
          logEl.innerHTML += `<br><strong>🤖 AI:</strong> ${msg.text}`;
          renderDB(msg.db);
          speakOutLoud(msg.text);
        }
      };
    }
    connectWS();

    function renderDB(db) {
      const tList = document.getElementById("taskList");
      tList.innerHTML = db.tasks.length ? db.tasks.map(t =>
        `<li class="${t.status === 'completed' ? 'done' : ''}">
          <span>${t.title}</span><span>[${t.status}]</span>
        </li>`
      ).join("") : "<li>No tasks yet</li>";

      const vList = document.getElementById("vaultList");
      vList.innerHTML = db.vault.length ? db.vault.map(v =>
        `<li><strong>${v.topic}:</strong> <span>${v.value}</span></li>`
      ).join("") : "<li>No vault records yet</li>";
    }

    function sendText() {
      const inp = document.getElementById("cmdInput");
      const text = inp.value.trim();
      if (!text) return;
      logEl.innerHTML = `<strong>👤 You:</strong> ${text}`;
      ws.send(JSON.stringify({ type: "voice_command", text }));
      inp.value = "";
    }

    function speakOutLoud(text) {
      synth.cancel();
      const u = new SpeechSynthesisUtterance(text);
      u.rate = 1.05;
      u.onstart = () => { orb.className = "orb speaking"; statusEl.innerText = "AI Speaking (Talk to interrupt)..."; };
      u.onend = () => {
        if (isListening) { orb.className = "orb listening"; statusEl.innerText = "Listening Live..."; }
        else { orb.className = "orb"; statusEl.innerText = "Tap Orb to Start Live Voice"; }
      };
      synth.speak(u);
    }

    function toggleVoice() {
      const SpeechRec = window.SpeechRecognition || window.webkitSpeechRecognition;
      if (!SpeechRec) {
        alert("Use Google Chrome or Edge for built-in free voice recognition.");
        return;
      }
      if (!isListening) {
        isListening = true;
        recognition = new SpeechRec();
        recognition.continuous = true;
        recognition.interimResults = true;
        recognition.lang = "en-IN";

        recognition.onresult = (e) => {
          const latest = e.results[e.results.length - 1];
          const text = latest[0].transcript.trim();

          // Instant Barge-In Interruption
          if (synth.speaking && text.length > 2) {
            synth.cancel();
            orb.className = "orb listening";
          }
          if (latest.isFinal && text.length > 0) {
            logEl.innerHTML = `<strong>👤 You:</strong> ${text}`;
            ws.send(JSON.stringify({ type: "voice_command", text }));
          }
        };
        recognition.onend = () => { if (isListening) recognition.start(); };
        recognition.start();
        orb.className = "orb listening";
        statusEl.innerText = "Listening Live...";
      } else {
        isListening = false;
        recognition.stop();
        synth.cancel();
        orb.className = "orb";
        statusEl.innerText = "Voice Paused — Tap Orb to Resume";
      }
    }
  </script>
</body>
</html>
